{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "javascript": { "globals": ["Bun"] },
  "extends": ["ultracite/biome/core"],
  "files": {
    "includes": ["!!bun.lock", "!!dist", "!!build"]
  },
  "assist": {
    "actions": {
      "source": {
        // Only class/className sorting (linter: useTailwindSortedClasses) is enabled.
        "organizeImports": "off",
        "useSortedAttributes": "off",
        "useSortedKeys": "off",
        "useSortedEnumMembers": "off",
        "useSortedInterfaceMembers": "off",
        "useSortedProperties": "off",
        "useSortedTypeFields": "off",
        "useSortedSelectionSet": "off",
        "useGraphqlSortedDefinitions": "off",
        "useGraphqlSortedVariables": "off",
        "useGraphqlSortedArguments": "off",
        "useSortedPackageJson": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "test/docs-contract.test.ts",
        "test/lifecycle.test.ts",
        "test/notify.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            // Test fixtures and regex matches are asserted by the surrounding test; allow concise fixture access.
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
